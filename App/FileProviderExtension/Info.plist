<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>FreeMountKeychainAccessGroup</key>
    <string>$(AppIdentifierPrefix)com.freemount.credentials</string>
    <key>CFBundleDisplayName</key>
    <string>FM</string>
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleSymbolName</key>
            <string>FreeMountFinder</string>
        </dict>
    </dict>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>FreeMountFileProvider</string>
    <key>CFBundlePackageType</key>
    <string>XPC!</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>3</string>
    <key>AppGroupIdentifier</key>
    <string>$(TeamIdentifierPrefix)group.com.freemount.shared</string>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.fileprovider-nonui</string>
        <key>NSExtensionPrincipalClass</key>
        <string>$(PRODUCT_MODULE_NAME).FreeMountFileProviderExtension</string>
        <key>NSExtensionFileProviderSupportsEnumeration</key>
        <true/>
        <key>NSExtensionFileProviderSupportsSyncing</key>
        <true/>
        <key>NSExtensionFileProviderAppliesChangesAtomically</key>
        <true/>
        <key>NSExtensionFileProviderDownloadPipelineDepth</key>
        <integer>4</integer>
        <key>NSExtensionFileProviderUploadPipelineDepth</key>
        <integer>2</integer>
        <key>NSExtensionFileProviderActions</key>
        <array>
            <dict>
                <key>NSExtensionFileProviderActionIdentifier</key>
                <string>com.freemount.action.makeAvailableOffline</string>
                <key>NSExtensionFileProviderActionName</key>
                <string>Make Available Offline</string>
                <key>NSExtensionFileProviderActionActivationRule</key>
                <string>SUBQUERY(fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.isPinned == 1).@count == 0</string>
            </dict>
            <dict>
                <key>NSExtensionFileProviderActionIdentifier</key>
                <string>com.freemount.action.removeOfflineCopy</string>
                <key>NSExtensionFileProviderActionName</key>
                <string>Remove Offline Copy</string>
                <key>NSExtensionFileProviderActionActivationRule</key>
                <string>SUBQUERY(fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.isPinned == 1).@count > 0</string>
            </dict>
        </array>
        <key>NSFileProviderDecorations</key>
        <array>
            <dict>
                <key>Identifier</key>
                <string>com.freemount.decoration.pinned</string>
                <key>BadgeImageType</key>
                <string>com.apple.icon-decoration.badge.pinned</string>
                <key>Category</key>
                <string>Badge</string>
                <key>Label</key>
                <string>Pinned Offline</string>
            </dict>
            <dict>
                <key>Identifier</key>
                <string>com.freemount.decoration.pinnedFolder</string>
                <key>BadgeImageType</key>
                <string>com.apple.icon-decoration.badge.pinned</string>
                <key>Category</key>
                <string>FolderBadge</string>
                <key>Label</key>
                <string>Pinned Offline</string>
            </dict>
        </array>
    </dict>
</dict>
</plist>
